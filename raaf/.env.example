# Copy to .env (never commit .env). Loaded by `node --env-file=.env` or your host's env settings.
PORT=3000
NODE_ENV=development

# SQLite file location. On a host, point this at a persistent disk/volume.
DATABASE_PATH=./data/raaf.db

# Cookie-signing / session settings
SESSION_TTL_HOURS=12

# Seed behaviour on an EMPTY database:
#   SEED_DEMO_DATA=true  -> demo users (see README) + sample RAAF records
#   SEED_DEMO_DATA=false -> only the first admin below is created
SEED_DEMO_DATA=true
# Required in production when SEED_DEMO_DATA=false (min 12 chars)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
